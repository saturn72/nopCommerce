@model IList<BrandProductModel>

@{
    NopHtml.AddCssFileParts(@$"{Consts.CONTENT_PATH}css/styles.css", null);
}

<section class="block block-brands">
    <div class="brand-list-container">
        <div class="listbox">
            <ul class="list">
                @for (var i = 0; i < Model.Count; i++)
                {
                    var brand = Model[i];
                    var picture = brand.Logo;
                    <li @(i == Model.Count - 1 ? @Html.Raw(" class=\"last\"") : null)>
                        @if (picture != null && !string.IsNullOrEmpty(picture.ThumbImageUrl))
                        {
                            var title = picture.Title ?? brand.Name;
                            <a class="product-brand" href="@(await NopUrl.RouteGenericUrlAsync<Brand>(new { SeName = brand.SeName }))" title="@title">
                                <img alt="@picture.AlternateText" src="@picture.ThumbImageUrl" title="@picture.Title" />
                            </a>
                        }
                        else
                        {
                            <a class="brand-name" href="@(await NopUrl.RouteGenericUrlAsync<Brand>(new { SeName = brand.SeName }))" title="@brand.Logo?.Title ?? @brand.Name">
                                @brand.Name.ToUpper()
                            </a>
                        }
                    </li>
                }
            </ul>
        </div>
    </div>
</section>
