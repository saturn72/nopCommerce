@model CreateOrUpdateFairVendorModel


@{
    var vendor = await WorkContext.GetCurrentVendorAsync();
}
<div class="card-body">
    @if (Model.Id == 0)
    {
        <div class="form-group row">
            <div class="col-md-3">
                <nop-label asp-for="VendorId" />
            </div>
            <div class="col-md-9">
                <nop-select asp-for="VendorId" asp-items="Model.AvailableVendors" />
            </div>
        </div>
    }
    else
    {
        <div class="form-group row">
            <div class="col-md-3">
                <nop-label asp-for="VendorName" />
            </div>
            <div class="col-md-9">
                <nop-editor asp-for="VendorName" html-attributes="@(new { disabled = true })" />
            </div>
        </div>
    }

    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="AutoApproveProducts" />
        </div>
        <div class="col-md-9">

            @{
                var ha = vendor == default ? new object() : new { disabled = true };
            }
            <nop-editor asp-for="AutoApproveProducts" html-attributes="@(ha)" />
            <span asp-validation-for="AutoApproveProducts"></span>
        </div>
    </div>

    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="DisplayOrder" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="DisplayOrder" />
            <span asp-validation-for="DisplayOrder"></span>
        </div>
    </div>
</div>
