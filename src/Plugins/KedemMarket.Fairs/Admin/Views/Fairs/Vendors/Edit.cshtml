@model CreateOrUpdateFairVendorModel

@{
    Layout = "_AdminLayout";
    ViewBag.PageTitle = T("Admin.Fairs.Vendors.Edit").Text;
}

<form asp-controller="Fair"
      asp-action="EditFairVendor"
      method="post"
      id="fair-vendor-form">
    <div class="content-header clearfix">
        <h1 class="float-left">
            @T("Admin.Fairs.Vendors.Edit")
            <small>
                <i class="fas fa-arrow-circle-left"></i>
                <a asp-action="Edit" asp-route-id="@Model.FairId">@T("Admin.Fairs.BackToFair")</a>
            </small>
        </h1>
        <div class="float-right">
            <button type="submit" name="save" class="btn btn-primary">
                <i class="far fa-floppy-disk"></i>
                @T("Admin.Common.Save")
            </button>
            <button type="submit" name="save-continue" class="btn btn-primary">
                <i class="far fa-floppy-disk"></i>
                @T("Admin.Common.SaveContinue")
            </button>
            <span id="fair-vendor-delete" class="btn btn-danger">
                <i class="far fa-trash-can"></i>
                @T("Admin.Common.Delete")
            </span>
        </div>
    </div>
    @await Html.PartialAsync(FairController.GetViewPath("Vendors/_CreateOrUpdate.cshtml"), Model)
</form>
<nop-delete-confirmation asp-model-id="@Model.Id" asp-button-id="fair-vendor-delete" asp-action="DeleteFairVendor" />