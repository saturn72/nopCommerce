@model FairAdminModel

@if (Model.Id > 0)
{
    <div class="card-body">
        @await Html.PartialAsync("Table", new DataTablesModel
   {
       Name = "fair-vendors-grid",
       UrlRead = new DataUrl(nameof(FairController.FairVendorList), "Fair", new RouteValueDictionary
       {
           [nameof(Model.FairVendorSearchModel.FairId)] = Model.Id,
       }),
       //UrlDelete = new DataUrl(nameof(FairController.DeleteFairVendor), "Fair", null),
       UrlUpdate = new DataUrl(nameof(FairController.EditFairVendor), "Fair", null),
       Length = Model.FairVendorSearchModel.PageSize,
       LengthMenu = Model.FairVendorSearchModel.AvailablePageSizes,
       ColumnCollection = new List<ColumnProperty>
    {

    new ColumnProperty(nameof(FairVendorAdminModel.Name))
    {
    Title = T("Admin.FairVendor.Fields.Name").Text,
    Width = "150",
    ClassName = NopColumnClassDefaults.CenterAll,
    Editable = true,
    EditType = EditType.String
    },

     new ColumnProperty(nameof(FairVendorAdminModel.AutoApproveProducts))
     {
     Title = T("Admin.FairVendor.Fields.AutoApproveProducts").Text,
     Width = "100",
     ClassName = NopColumnClassDefaults.CenterAll,
     Render = new RenderBoolean(),
     Editable = true,
     EditType = EditType.Checkbox
     },
    new ColumnProperty(nameof(FairVendorAdminModel.DisplayOrder))
    {
    Title = T("Admin.FairVendor.Fields.DisplayOrder").Text,
    Width = "150",
    ClassName = NopColumnClassDefaults.CenterAll,
    Editable = true,
    EditType = EditType.String
    },
    new ColumnProperty(nameof(FairVendorAdminModel.Id))
    {
    Title = T("Admin.Common.Edit").Text,
    Width = "200",
    ClassName =  NopColumnClassDefaults.Button,
    Render = new RenderButtonEdit(new DataUrl("~/Admin/Fair/EditFairVendor", nameof(FairVendorAdminModel.Id))),
    }
    }
    })
    </div>
    <div class="card-footer">
        <a asp-action="FairVendorCreate" asp-route-fairId="@Model.Id" class="btn btn-primary">
            <i class="fas fa-square-plus"></i>
            @T("Admin.Fairs.Vendors.AddNew")
        </a>
    </div>
}
else
{
    <div class="card-body">
        @T("Admin.Fairs.Vendors.SaveBeforeEdit")
    </div>
}

