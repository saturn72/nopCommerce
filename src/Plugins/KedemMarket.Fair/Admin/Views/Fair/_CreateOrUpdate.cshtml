@using Nop.Web.Areas.Admin.Components
@model FairInfoAdminModel

@{
    const string hideInfoBlockAttributeName = "FairPage.HideInfoBlock";
    var customer = await WorkContext.GetCurrentCustomerAsync();
    var hideInfoBlock = await GenericAttributeService.GetAttributeAsync<bool>(customer, hideInfoBlockAttributeName);

    const string hideVendorsBlockAttributeName = "FairPage.HideVendorsBlock";
    var hideProductsBlock = await GenericAttributeService.GetAttributeAsync<bool>(customer, hideVendorsBlockAttributeName, defaultValue: true);

    const string hideDisplayBlockAttributeName = "FairPage.HideDisplayBlock";
    var hideDisplayBlock = await GenericAttributeService.GetAttributeAsync<bool>(customer, hideDisplayBlockAttributeName, defaultValue: true);

    const string hideMappingsBlockAttributeName = "FairPage.HideMappingsBlock";
    var hideMappingsBlock = await GenericAttributeService.GetAttributeAsync<bool>(customer, hideMappingsBlockAttributeName, defaultValue: true);

    const string hideSeoBlockAttributeName = "FairPage.HideSEOBlock";
    var hideSeoBlock = await GenericAttributeService.GetAttributeAsync<bool>(customer, hideSeoBlockAttributeName, defaultValue: true);
}

<div asp-validation-summary="All"></div>
<input asp-for="Id" type="hidden" />

<section class="content">
    <div class="container-fluid">
        <div class="form-horizontal">
            <div class="row">
                <div class="col-md-12 clearfix">
                    <div class="float-left">
                        @await Component.InvokeAsync(typeof(SettingModeViewComponent), new { modeName = "fair-advanced-mode" })
                    </div>
                </div>
            </div>

            <nop-cards id="fair-cards">
                <nop-card asp-name="fair-info" asp-icon="fas fa-info" asp-title="@T("Admin.Fairs.Info")" asp-hide-block-attribute-name="@hideInfoBlockAttributeName" asp-hide="@hideInfoBlock" asp-advanced="false">@await Html.PartialAsync(FairController.GetViewPath("_CreateOrUpdate.Info.cshtml"), Model)</nop-card>
                <nop-card asp-name="fair-vendors" asp-icon="fas fa-store" asp-title="@T("Admin.Fairs.Vendors")" asp-hide-block-attribute-name="@hideVendorsBlockAttributeName " asp-hide="@hideProductsBlock" asp-advanced="true">@await Html.PartialAsync(FairController.GetViewPath("_CreateOrUpdate.Vendors.cshtml"), Model)</nop-card>
                @* <nop-card asp-name="fair-display" asp-icon="fas fa-tv" asp-title="@T("Admin.Fairs.Display")" asp-hide-block-attribute-name="@hideDisplayBlockAttributeName" asp-hide="@hideDisplayBlock" asp-advanced="false">@await Html.PartialAsync("_CreateOrUpdate.Display", Model)</nop-card> *@
                @* <nop-card asp-name="fair-mappings" asp-icon="fas fa-bookmark" asp-title="@T("Admin.Fairs.Mappings")" asp-hide-block-attribute-name="@hideMappingsBlockAttributeName" asp-hide="@hideMappingsBlock" asp-advanced="true">@await Html.PartialAsync("_CreateOrUpdate.Mappings", Model)</nop-card> *@
                @* <nop-card asp-name="fair-seo" asp-icon="fas fa-magnifying-glass-plus" asp-title="@T("Admin.Common.SEO")" asp-hide-block-attribute-name="@hideSeoBlockAttributeName" asp-hide="@hideSeoBlock" asp-advanced="true">@await Html.PartialAsync("_CreateOrUpdate.Seo", Model)</nop-card> *@
            </nop-cards>
        </div>
    </div>
</section>