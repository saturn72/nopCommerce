@{
    Layout = "_AdminLayout";
}
@model FairInfoAdminModel

@{
    ViewBag.PageTitle = T("Admin.Fairs.AddNew").Text;
    NopHtml.SetActiveMenuItemSystemName("Fairs");
}

<form asp-controller="Fair" asp-action="Create" method="post" id="fair-form">
    <div class="content-header clearfix">
        <h1 class="float-left">
            @T("Admin.Fairs.AddNew")
            <small>
                <i class="fas fa-arrow-circle-left"></i>
                <a asp-action="List">@T("Admin.Fairs.BackToList")</a>
            </small>
        </h1>
        <div class="float-right">
            <button type="submit" name="save" class="btn btn-primary">
                <i class="far fa-floppy-disk"></i>
                @T("Admin.Common.Save")
            </button>
            <button type="submit" name="save-continue" class="btn btn-primary">
                <i class="far fa-floppy-disk"></i>
                @T("Admin.Common.SaveContinue")
            </button>
        </div>
    </div>
    @await Html.PartialAsync(FairController.GetViewPath("_CreateOrUpdate.cshtml"), Model)
</form>