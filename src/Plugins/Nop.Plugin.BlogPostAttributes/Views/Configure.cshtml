@model Saturn72.BlogPostExtensions.Models.BlogPostExtensionsConfigurationModel

@{
    Layout = "_ConfigurePlugin";
}

<div class="cards-group">
    <div class="card card-default">
        <div class="card-body">
            <form asp-controller="BlogPostAttributesConfigure" asp-action="Configure" method="post">
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="MaxSubtitleLength" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="MaxSubtitleLength" html-attributes="@(new { data_toggle = "tooltip", title = T("Plugins.BlogPostAttributes.Fields.MaxSubtitleLength.Hint").Text, data_trigger = "focus", data_placement = "top" })" />
                        <span asp-validation-for="MaxSubtitleLength"></span>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="MinSubtitleLength" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="MinSubtitleLength" html-attributes="@(new { data_toggle = "tooltip", title = T("Plugins.BlogPostAttributes.Fields.MinSubtitleLength.Hint").Text, data_trigger = "focus", data_placement = "top" })" />
                        <span asp-validation-for="MinSubtitleLength"></span>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-9 offset-md-3">
                        <input type="submit" name="save" class="btn btn-primary" value="@T("Admin.Common.Save")" />
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
